# EAS must NOT upload the whole monorepo (12GB+). Mobile app only lives in mobile-build/
# If you see "archive is too big", run: cd mobile-build && bash build-mac.sh

*
!mobile-build/

# Still trim what EAS installs fresh on the server anyway
mobile-build/node_modules/
mobile-build/store-assets/

# Legacy explicit excludes (if building from a subfolder)
attached_assets/
.local/
artifacts/
.migration-backup/
node_modules/
.git/
server/
screenshots/
docs/
*.mp4
*.mov
*.wav
*.zip
*.ipa
*.apk
