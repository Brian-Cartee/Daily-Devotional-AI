{
  "expo": {
    "name": "Shepherd's Path",
    "slug": "shepherds-path-mobile",
    "version": "2.1.9",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "shepherdspath",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0d0612"
    },
    "ios": {
      "bundleIdentifier": "com.shepherdspath.app",
      "buildNumber": "179",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Shepherd's Path does not use the camera.",
        "NSMicrophoneUsageDescription": "Shepherd's Path uses the microphone to let you speak your heart — in Talk It Through and Sermon Mode.",
        "NSSpeechRecognitionUsageDescription": "Shepherd's Path uses speech recognition so you can speak instead of type when sharing what's on your heart.",
        "NSPhotoLibraryUsageDescription": "Shepherd's Path does not access your photo library.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": true
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePurchaseHistory",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "com.shepherdspath.app",
      "versionCode": 126,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#0d0612"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://www.shepherdspathai.com"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": "Shepherd's Path uses the microphone in Sermon Mode to detect scripture references as your pastor speaks."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#7A018D",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "./plugins/withTalkItThroughIntent"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "b916bb13-03ee-45a4-86a4-cbe7a11c34a7"
      }
    },
    "owner": "shepherdspath"
  }
}
