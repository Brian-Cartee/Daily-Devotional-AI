# Philip Voice Lab — copy to artifacts/api-server/.env.philip-lab (never commit secrets)

PHILIP_VOICE_LAB_ENABLED=true
PHILIP_VOICE_LAB_SECRET=change-me-long-random-string

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

PHILIP_VOICE_LAB_AGENT_PORT=8091
PHILIP_VOICE_LAB_AGENT_DISPATCH_URL=http://127.0.0.1:8091/dispatch
PHILIP_VOICE_LAB_API_BASE=http://127.0.0.1:8080
PHILIP_VOICE_LAB_SAMPLE_RATE=48000

# Per-turn runtime path verification (agent stdout)
# PHILIP_VOICE_LAB_RUNTIME_VERIFY=true

# Fix #2 — conversation feel (VAD)
# PHILIP_VOICE_LAB_VAD_SILENCE_MS=900
# PHILIP_VOICE_LAB_VAD_MIN_SPEECH_MS=380
# PHILIP_VOICE_LAB_VAD_MAX_MS=45000
# PHILIP_VOICE_LAB_VAD_ENERGY=450

# Fix #2b — async playback + barge-in (default ON; set false to revert)
# PHILIP_VOICE_LAB_ASYNC_PLAYBACK=true
# PHILIP_VOICE_LAB_INTERRUPT_PROTECT_MS=800
# PHILIP_VOICE_LAB_INTERRUPT_SUSTAIN_MS=550
# PHILIP_VOICE_LAB_INTERRUPT_ENERGY_MULT=1.75
# PHILIP_VOICE_LAB_INTERRUPT_MIN_BYTES=3200

# ffmpeg required on PATH for MP3→PCM playback (or set FFMPEG_PATH)
# FFMPEG_PATH=/usr/bin/ffmpeg
