# Philip Voice Lab — copy to artifacts/api-server/.env.philip-lab (never commit secrets)
#
# Isolated deployment (recommended):
#   philip-lab-api  → PORT=3101  (session minting + timeline + CANDIDATE guidance brain)
#   production API  → :3001     (transcription + TTS media only)
#   voice agent     → :8091     (LiveKit worker)

PHILIP_VOICE_LAB_ENABLED=true
PHILIP_VOICE_LAB_SECRET=change-me-long-random-string

# Isolated lab API (bind loopback; nginx proxies /api/internal/philip-voice/* here)
PORT=3101
HOST=127.0.0.1
PHILIP_VOICE_LAB_API_BASE=http://127.0.0.1:3101

# Candidate guidance brain (Conversation Front Door) — the isolated lab service.
# Response generation runs here and NEVER touches the production runtime.
PHILIP_VOICE_LAB_GUIDANCE_API_BASE=http://127.0.0.1:3101

# Isolated authenticated STT (Whisper) — lab service, NOT production customer budgets.
# Defaults to the guidance/lab API base (:3101). Requires X-Philip-Lab-Secret.
PHILIP_VOICE_LAB_STT_API_BASE=http://127.0.0.1:3101

# Lab STT financial guards (defaults are generous for private testing, not unlimited)
# PHILIP_VOICE_LAB_STT_MAX_UTTERANCE_MS=60000
# PHILIP_VOICE_LAB_STT_MAX_REQUESTS_PER_SESSION_DAY=80
# PHILIP_VOICE_LAB_STT_MAX_REQUESTS_PER_DAY=200
# PHILIP_VOICE_LAB_STT_MAX_MINUTES_PER_DAY=60
# PHILIP_VOICE_LAB_STT_MAX_FILE_BYTES=26214400

# Media — TTS only uses the production API on loopback (guidance scope skips listen policy).
# Do NOT point STT here; production /api/guidance/transcribe enforces customer daily limits.
PHILIP_VOICE_LAB_MEDIA_API_BASE=http://127.0.0.1:3001

# Model that generates Philip's live substantive responses (default gpt-4o).
# REQUIRED for live lab mode: without OPENAI_API_KEY the candidate guidance fails
# readiness (503) instead of silently serving canned deterministic conversation.
PHILIP_VOICE_LAB_BRAIN_MODEL=gpt-4o
# OPENAI_API_KEY=

# Diagnostics ONLY — allow deterministic (canned) deep responses without a model
# key. Never enable in a real device test; it exists for offline smoke checks.
# PHILIP_VOICE_LAB_ALLOW_DETERMINISTIC=false

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

PHILIP_VOICE_LAB_AGENT_PORT=8091
PHILIP_VOICE_LAB_AGENT_DISPATCH_URL=http://127.0.0.1:8091/dispatch
PHILIP_VOICE_LAB_SAMPLE_RATE=48000

# Optional: separate directory for lab timeline JSON (default: server/philip-voice-lab)
# PHILIP_VOICE_LAB_LOG_DIR=/var/lib/shepherdspath/philip-voice-lab

# Per-turn runtime path verification (agent stdout). On by default in the lab;
# set to false to silence. Per-turn JSON is also written to PHILIP_VOICE_LAB_LOG_DIR
# as <conversationId>.turns.jsonl (transcript, response, intent, lane, engine,
# state transition, latencies, VAD reason — no secrets).
# PHILIP_VOICE_LAB_RUNTIME_VERIFY=true

# Fix #2 — conversation feel (VAD). Default silence window is now 1400ms so natural
# reflective pauses are not truncated. Override here if needed.
# PHILIP_VOICE_LAB_VAD_SILENCE_MS=1400
# PHILIP_VOICE_LAB_VAD_MIN_SPEECH_MS=380
# PHILIP_VOICE_LAB_VAD_MAX_MS=45000
# PHILIP_VOICE_LAB_VAD_ENERGY=450

# Fix #2b — async playback + barge-in (default ON; set false to revert)
# PHILIP_VOICE_LAB_ASYNC_PLAYBACK=true
# PHILIP_VOICE_LAB_INTERRUPT_PROTECT_MS=800
# PHILIP_VOICE_LAB_INTERRUPT_SUSTAIN_MS=550
# PHILIP_VOICE_LAB_INTERRUPT_ENERGY_MULT=1.75
# PHILIP_VOICE_LAB_INTERRUPT_MIN_BYTES=3200

# ffmpeg required on PATH for MP3→PCM playback (or set FFMPEG_PATH)
# FFMPEG_PATH=/usr/bin/ffmpeg
