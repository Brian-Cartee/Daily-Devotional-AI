# Copy to .env on your AWS VPS (same directory you run `pnpm start` from).
# Optional: set DOTENV_CONFIG_PATH=/path/to/.env to load a file elsewhere.

NODE_ENV=production
PORT=3000
# Bind on all interfaces (required for AWS VPS / reverse proxy)
HOST=0.0.0.0

# Required
DATABASE_URL=postgresql://user:password@localhost:5432/daily_devotional

# OpenAI (use one of the two options)
OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend — preferred on VPS; Replit connector vars optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Push notifications (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@shepherdspathAI.com

# SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App URLs
APP_URL=https://your-domain.com
WELCOME_VIDEO_URL=

# Admin
ADMIN_PASSWORD=
# ADMIN_BYPASS=

# Schedulers
ENABLE_EMAIL_SCHEDULER=true

# Media / integrations (optional)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Android / deep links (optional)
ANDROID_PACKAGE_NAME=com.shepherdspath.app
ANDROID_SHA256_CERT=

# Logging
LOG_LEVEL=info

# Promo codes (comma-separated, optional)
# PROMO_CODES=
