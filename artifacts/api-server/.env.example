# Setup (local or AWS VPS):
#   cd artifacts/api-server
#   cp .env.example .env
#   # edit DATABASE_URL and other secrets
#   pnpm run build && pnpm start
#
# Optional: DOTENV_CONFIG_PATH=/full/path/to/.env

NODE_ENV=production
PORT=3000
# Bind on all interfaces (required for AWS VPS / reverse proxy)
HOST=0.0.0.0

# Required
DATABASE_URL=postgresql://user:password@localhost:5432/daily_devotional

# OpenAI (required on Lightsail — do not use Replit AI_INTEGRATIONS_* )
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend — preferred on VPS; Replit connector vars optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@shepherdspathai.com

# Push notifications (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@shepherdspathAI.com

# SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App URLs
APP_URL=https://www.shepherdspathai.com
WELCOME_VIDEO_URL=

# Admin
ADMIN_PASSWORD=
# ADMIN_BYPASS=

# Schedulers
ENABLE_EMAIL_SCHEDULER=true

# Media / integrations (optional)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
YOUTUBE_API_KEY=
# Option A: service account JSON (one line)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Option B: if Google blocks JSON keys — Apps Script web app URL (see docs/GOOGLE_SHEETS_APPS_SCRIPT.md)
# GOOGLE_SHEET_WEB_APP_URL=https://script.google.com/macros/s/.../exec

# Android / deep links (optional)
ANDROID_PACKAGE_NAME=com.shepherdspath.app
ANDROID_SHA256_CERT=

# Logging
LOG_LEVEL=info

# Promo codes (comma-separated, optional)
# PROMO_CODES=
