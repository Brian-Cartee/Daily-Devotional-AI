{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps --env-file=.env ./dist/index.mjs",
    "start:prod": "NODE_ENV=production node --enable-source-maps --env-file=.env ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate-vapid": "node ../../scripts/generate-vapid-keys.mjs",
    "seed:pastor-videos": "node --enable-source-maps --env-file=.env.development --import tsx/esm ./src/seedPastorVideos.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "file:../../lib/api-zod",
    "@workspace/db": "file:../../lib/db",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.7",
    "expo-server-sdk": "^6.1.0",
    "express": "^5",
    "googleapis": "^171.4.0",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "openai": "^6.34.0",
    "p-limit": "^7.3.0",
    "p-retry": "^8.0.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "pino": "^9",
    "pino-http": "^10",
    "resend": "^6.12.2",
    "stripe": "^22.0.2",
    "twilio": "^6.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "youtube-transcript": "^1.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.4",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "^4.19.4"
  }
}
