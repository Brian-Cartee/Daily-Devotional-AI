# ── LOCAL DEVELOPMENT ONLY — never deploy this file ─────────────────────────
# Setup:
#   cd artifacts/api-server
#   cp .env.development.example .env.development
#   # paste your DEV OpenAI key (see OpenAI steps below)
#
# Run API locally (uses this file, NOT production .env):
#   pnpm run dev
#
# OpenAI — create a separate dev project (platform.openai.com):
#   1. New project: "Shepherds Path DEV"
#   2. API Keys → Create key → paste below
#   3. Settings → Limits → set hard monthly budget to $5
#   4. OPENAI_KEY_ENV=development is required — server refuses prod keys in dev mode

NODE_ENV=development
OPENAI_KEY_ENV=development
OPENAI_API_KEY=sk-proj-REPLACE_WITH_DEV_KEY_ONLY

PORT=8080
HOST=0.0.0.0
LOG_LEVEL=debug

# Use a separate database — never point at production Postgres
# Local: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:16
# Or a dedicated Railway "dev" database URL
DATABASE_URL=postgresql://postgres:dev@localhost:5432/shepherds_path_dev

# Local app URL (matches Vite dev server + proxy)
APP_URL=http://localhost:3000

# Disable background jobs in dev (no real emails/SMS/push blasts)
ENABLE_EMAIL_SCHEDULER=false

# Stripe test keys only (optional — dashboard.stripe.com → Developers → Test mode)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Leave empty in dev unless testing email (use Resend test domain)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Admin for /shepherd-admin locally
ADMIN_PASSWORD=local-dev-only

# Optional: test pre-written reflection/prayer fallback without calling OpenAI
# DEVOTIONAL_FORCE_FALLBACK=1
